{
  "name": "@creator-studio/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Creator Studio: app de escritorio (Tauri) que reúne Videos, Imágenes y Descargas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.preview.config.ts",
    "e2e:ui": "playwright test --ui-host=0.0.0.0 --ui-port=9323"
  },
  "dependencies": {
    "@creator-studio/downloads": "workspace:*",
    "@creator-studio/images": "workspace:*",
    "@creator-studio/ui": "workspace:*",
    "@creator-studio/videos": "workspace:*",
    "@gravity-ui/icons": "^2.24.0",
    "@heroui/react": "^3.2.8",
    "@heroui/styles": "^3.2.8",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
