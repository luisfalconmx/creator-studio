{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/src-tauri/gen",
      "!target",
      "!**/dist",
      "!.claude/skills",
      "!.agents",
      "!skills-lock.json",
      "!**/.turbo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "react": "recommended",
      "test": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/videos/src/**", "packages/downloads/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "warn"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn"
          },
          "a11y": {
            "noStaticElementInteractions": "warn",
            "useMediaCaption": "off",
            "useSemanticElements": "warn",
            "useFocusableInteractive": "warn"
          }
        }
      }
    }
  ]
}
